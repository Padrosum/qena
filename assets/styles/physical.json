{
  "version": 8,
  "name": "Qena Fiziki / İdari",
  "glyphs": "/assets/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "land": {
      "type": "geojson",
      "data": "/assets/ne/ne_110m_land.geojson"
    },
    "countries": {
      "type": "geojson",
      "data": "/assets/ne/ne_110m_admin_0_countries.geojson"
    },
    "lakes": {
      "type": "geojson",
      "data": "/assets/ne/ne_110m_lakes.geojson"
    },
    "rivers": {
      "type": "geojson",
      "data": "/assets/ne/ne_110m_rivers_lake_centerlines.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f3efe3" }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "land",
      "paint": { "fill-color": "#e8e0cc" }
    },
    {
      "id": "lakes",
      "type": "fill",
      "source": "lakes",
      "paint": { "fill-color": "#a9c7d8" }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "rivers",
      "paint": { "line-color": "#8fb3c9", "line-width": 1 }
    },
    {
      "id": "countries",
      "type": "line",
      "source": "countries",
      "paint": { "line-color": "#9b8b73", "line-width": 1 }
    },
    {
      "id": "country-labels",
      "type": "symbol",
      "source": "countries",
      "layout": {
        "text-field": ["get", "NAME"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#5d5244",
        "text-halo-color": "#f3efe3",
        "text-halo-width": 1
      }
    }
  ]
}
